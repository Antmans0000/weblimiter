<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF (for UI Automation) drops System.IO from the implicit usings. -->
    <Using Include="System.IO" />
    <ProjectReference Include="..\..\src\WebLimiter.Core\WebLimiter.Core.csproj" />
    <None Include="..\..\native\x64\WinDivert.dll" Link="WinDivert.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\x64\WinDivert64.sys" Link="WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
