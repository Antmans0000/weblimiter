<Window x:Class="WebLimiter.App.QuotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quota" Width="430" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22,18">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="Une fois le quota atteint sur la période, l'application est bloquée ou ralentie jusqu'à la période suivante."
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16" />

        <CheckBox x:Name="EnabledBox" Content="Activer le quota" Margin="0,0,0,14" Click="EnabledBox_Click" />

        <Grid x:Name="Fields">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Volume" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="AmountBox" Width="90" />
                <RadioButton x:Name="UnitMo" Style="{StaticResource Segment}" Content="Mo" Margin="10,0,0,0" GroupName="unit" />
                <RadioButton x:Name="UnitGo" Style="{StaticResource Segment}" Content="Go" GroupName="unit" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Période" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="PeriodDay" Style="{StaticResource Segment}" Content="Par jour" GroupName="period" />
                <RadioButton x:Name="PeriodMonth" Style="{StaticResource Segment}" Content="Par mois" GroupName="period" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Trafic compté" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="DirTotal" Style="{StaticResource Segment}" Content="Total" GroupName="dir" />
                <RadioButton x:Name="DirDown" Style="{StaticResource Segment}" Content="Reçu ↓" GroupName="dir" />
                <RadioButton x:Name="DirUp" Style="{StaticResource Segment}" Content="Envoyé ↑" GroupName="dir" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Ensuite" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="ActionBlock" Style="{StaticResource Segment}" Content="Bloquer" GroupName="action" Click="Action_Click" />
                <RadioButton x:Name="ActionLimit" Style="{StaticResource Segment}" Content="Ralentir" GroupName="action" Click="Action_Click" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Vitesse réduite" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="ThrottleBox" Width="90" />
                <TextBlock Text="Ko/s" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="Enregistrer" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
